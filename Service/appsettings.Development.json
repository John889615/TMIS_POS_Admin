{
  // Development-only overrides. Loaded ON TOP of appsettings.json when
  // ASPNETCORE_ENVIRONMENT=Development (set by Properties/launchSettings.json
  // for all three launch profiles). Anything not redeclared here falls
  // through to the values in appsettings.json.

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Save uploaded images inside the Service project so they can be served
  // by the static-file middleware in Program.cs (which mounts
  // <ContentRoot>/assets at /assets when LiveApp == "true"). Files end up
  // at C:\Sandbox\TMIS_POS_Admin\Service\assets\<relativeFolder>\<guid>.jpg
  // and are reachable at https://localhost:44392/assets/<relativeFolder>/<guid>.jpg.
  //
  // The path deliberately contains no {Path} or {TenantID} placeholders, so
  // ImageHelper's Replace calls are no-ops and we don't depend on the
  // GlobalSettings table having a matching row.
  "ImageStorage": {
    "RootFileSystemPath": "C:\\Sandbox\\TMIS_POS_Admin\\Service\\assets",
    "BaseUrl": "https://localhost:44392/assets",
    "LocalUrl": "https://localhost:44392/assets"
  },

  // Enables the static-file middleware in Program.cs that serves
  // <ContentRoot>/assets at /assets. Required for newly-saved images
  // to be reachable from the browser at the URLs above.
  "LiveApp": "true",

  // Local sync endpoint matches the dev API port (was pointing at 14045
  // in the base config, which doesn't match the dev launch profile).
  "Sync": {
    "url": "https://localhost:44392/api/Sync/list/"
  }
}
