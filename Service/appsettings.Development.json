{
  // Development-only overrides. Loaded ON TOP of appsettings.json when
  // ASPNETCORE_ENVIRONMENT=Development (set by Properties/launchSettings.json
  // for all three launch profiles). Anything not redeclared here falls
  // through to the values in appsettings.json.

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // ImageStorage block intentionally not overridden — values inherit
  // from appsettings.json (prod paths/URLs).

  // Enables the static-file middleware in Program.cs that serves
  // <ContentRoot>/assets at /assets when set to "true".
  "LiveApp": "true",

  // Local sync endpoint matches the dev API port (was pointing at 14045
  // in the base config, which doesn't match the dev launch profile).
  "Sync": {
    "url": "https://localhost:44392/api/Sync/list/"
  }
}
