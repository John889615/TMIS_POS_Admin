# Development overrides (committed). Loaded by Vite when running `npm run dev`.
#
# Both API URLs are relative paths that Vite proxies to the real upstreams
# during dev — see vite.config.js > server.proxy. This avoids CORS (Portal
# API blocks localhost origins) and self-signed cert issues (POS API on
# https://localhost:44392). Production overrides these with absolute URLs
# in .env.production (which is loaded for `npm run build`, not `npm run dev`).

VITE_PORTAL_API_URL=/portal-api
VITE_POS_API_URL=/pos-api
