# Reference template — documents every env var the app understands.
# Copy to .env.local and adjust if you need personal overrides.
# Variables MUST be prefixed VITE_ to be visible to client code.

VITE_BASE_PATH=/

# Portal API base URL.
# Dev: /portal-api  (Vite proxies to https://tmis.co.za/TMIS_Portal/Portal_Api/api)
# Prod: https://tmis.co.za/TMIS_Portal/Portal_Api/api  (direct, same-origin when deployed)
VITE_PORTAL_API_URL=https://tmis.co.za/TMIS_Portal/Portal_Api/api

# POS API base URL.
# Dev: /pos-api  (Vite proxies to https://localhost:44392/api, skipping self-signed cert)
# Prod: https://tmis.co.za/pos_bs/api
VITE_POS_API_URL=https://tmis.co.za/pos_bs/api

# Tenant key for white-label branding. Omit or set to "default" for the default brand.
# Consumed by src/utils/getBranding.js.
VITE_TENANT=default
